# 1. Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://argaewhbcqwsqdaaynmw.supabase.co

# 2. Supabase Publishable / Anon API Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_... or eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# (Also accepts NEXT_PUBLIC_SUPABASE_ANON_KEY interchangeably)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Supabase Service Role Secret Key (Optional, used for server-only admin actions)
# WARNING: NEVER expose this key in client-side code or public variables!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. On-demand Next.js Cache Revalidation Secret
REVALIDATION_SECRET=ebrahim-portfolio-cms-revalidate-secret-2026
